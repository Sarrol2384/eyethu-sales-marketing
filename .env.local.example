# --- Supabase (recommended: cloud — no Docker) ---
# Create a project at https://supabase.com → Settings → API
# Full checklist: docs/SUPABASE_CLOUD_SETUP.md
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: local Supabase only (requires Docker + `npx supabase start`)
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# --- Anthropic Claude (AI content generation + lead scoring summary) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Set to "false" to store rule-only lead summaries (no Claude call on /api/leads)
LEAD_AI_SUMMARY_ENABLED=true

# --- Brevo (email, SMS, contacts) ---
# Get a v3 API key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# The verified sender email/name configured in Brevo
BREVO_SENDER_EMAIL=hello@example.co.za
BREVO_SENDER_NAME=Eyethu Property Group
# SMS sender ID (max 11 chars, alphanumeric only)
BREVO_SMS_SENDER=EyethuPG
# Flip to "true" to actually fire SMS (each one costs money)
BREVO_SMS_ENABLED=false

# --- Site (port 3010 avoids clashing with other Eyethu apps on 3000 — see docs/LOCAL_DEV.md) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# --- Cal.com (viewing bookings, used in phase 10+) ---
CAL_COM_API_KEY=

# --- SA business rules ---
# SA prime lending rate (used as default in bond calculator). Update if it changes.
SA_PRIME_RATE=11.75

# --- Cron security (phase 11) ---
# Long random string; required in Authorization header for /api/cron/* routes.
CRON_SECRET=
